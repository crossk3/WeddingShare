@{
}
<div id="main-content">
    <div class="container px-3 px-lg-1 pb-4">
        <div class="row justify-content-center g-4 mt-3">
            <div class="col-12 col-md-6">
                <a href="/Rsvp" class="text-decoration-none">
                    <div class="card h-100 text-center">
                        <div class="card-header">
                            <h1 class="display-6">@_localizer["RSVP"].Value</h1>
                        </div>
                        <div class="card-body d-flex flex-column align-items-center justify-content-center p-5">
                            <i class="fa-solid fa-envelope fa-3x mb-3"></i>
                            <p class="card-text">@_localizer["RSVP_Description"].Value</p>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-12 col-md-6">
                <a href="/Gallery" class="text-decoration-none">
                    <div class="card h-100 text-center">
                        <div class="card-header">
                            <h1 class="display-6">@_localizer["Gallery_Landing_Title"].Value</h1>
                        </div>
                        <div class="card-body d-flex flex-column align-items-center justify-content-center p-5">
                            <i class="fa-solid fa-camera fa-3x mb-3"></i>
                            <p class="card-text">@_localizer["Gallery_Landing_Description"].Value</p>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>
