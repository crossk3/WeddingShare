@model WeddingShare.Models.PhotoGallery

@using WeddingShare.Constants

@{
    var userPermissions = User?.Identity?.GetUserPermissions() ?? new Permissions();

    // Group images into slides of 3
    var imagesPerSlide = 3;
    var slidesData = Model.Images?
        .Select((image, index) => new { image, index })
        .GroupBy(x => x.index / imagesPerSlide)
        .Select(g => g.Select(x => x.image).ToList())
        .ToList();

    // The carousel now receives the whole gallery rather than a single page, so a dot per
    // slide stops being usable past a few dozen - show a position counter beyond that.
    var maxIndicators = 20;
    var slideCount = slidesData?.Count ?? 0;
    var showIndicators = slideCount > 1 && slideCount <= maxIndicators;
    var showCounter = slideCount > maxIndicators;
}

<div class="col-12">
    @if (slidesData != null && slidesData.Any())
    {
        <div id="galleryCarousel" class="carousel carousel-mode slide" data-bs-ride="false">
            <!-- Indicators -->
            @if (showIndicators)
            {
                <div class="carousel-indicators">
                    @for (int i = 0; i < slidesData.Count; i++)
                    {
                        <button type="button" data-bs-target="#galleryCarousel" data-bs-slide-to="@i"
                                class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i + 1)"></button>
                    }
                </div>
            }

            @if (showCounter)
            {
                <div class="carousel-counter">
                    <span class="carousel-counter-current">1</span> / @slideCount
                </div>
            }

            <!-- Slides -->
            <div class="carousel-inner">
                @for (int slideIdx = 0; slideIdx < slidesData.Count; slideIdx++)
                {
                    <div class="carousel-item @(slideIdx == 0 ? "active" : "")">
                        <div class="carousel-multi-item">
                            @foreach (var image in slidesData[slideIdx])
                            {
                                <div class="image-tile carousel-image-tile">
                                    <a href="@image.ImagePath" class="media-viewer-item" data-media-viewer-id="@image.Id" data-media-viewer-index="@slideIdx" data-media-viewer-collection="@image.GalleryName" data-media-viewer-type="gallery_item">
                                        <img src="@image?.ThumbnailPath" class="w-100 shadow-1-strong" loading="lazy" alt="@image?.Name" />
                                        @if (image?.MediaType == MediaType.Video)
                                        {
                                            <img src="/images/play-button.svg" class="media-viewer-play" loading="lazy" alt="Play video" />
                                        }
                                        @if (User?.Identity != null &&
                                             User.Identity.IsAuthenticated &&
                                             userPermissions.Review.HasFlag(ReviewPermissions.Delete) &&
                                             !(Context?.Items.ContainsKey("IsReadonlyKey") == true && (bool)Context.Items["IsReadonlyKey"]!))
                                        {
                                            <i class="fa fa-trash btnDeletePhoto d-lg-none" data-photo-id="@image?.Id" data-photo-name="@image?.Name"></i>
                                        }
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Controls -->
            @if (slideCount > 1)
            {
                <button class="carousel-control-prev" type="button" data-bs-target="#galleryCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">@_localizer["Previous"].Value</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#galleryCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">@_localizer["Next"].Value</span>
                </button>
            }
        </div>
    }
</div>

@if (showCounter)
{
    <script>
        (function () {
            function bindCarouselCounter() {
                var carousel = document.getElementById('galleryCarousel');
                if (!carousel || carousel.dataset.counterBound) {
                    return;
                }

                var current = carousel.querySelector('.carousel-counter-current');
                if (!current) {
                    return;
                }

                carousel.dataset.counterBound = 'true';
                carousel.addEventListener('slid.bs.carousel', function (e) {
                    current.textContent = e.to + 1;
                });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', bindCarouselCounter);
            } else {
                bindCarouselCounter();
            }
        })();
    </script>
}

@if (Model?.LoadScripts ?? true)
{
    var idleTimeout = await _settings.GetOrDefault(Settings.Gallery.IdleRefreshMins, 0, Model?.Gallery?.Id);
    if (idleTimeout > 0)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                $(function () {
                    var idleTimeout;

                    onIdle();
                    $(document).on('mousemove keydown scroll click', onIdle);

                    function onIdle() {
                        clearTimeout(idleTimeout);
                        idleTimeout = setTimeout(function () {
                            refreshGalleryPage(onIdle);
                        }, @TimeSpan.FromMinutes(idleTimeout).TotalMilliseconds);
                    }
                });
            }, false);
        </script>
    }
}
